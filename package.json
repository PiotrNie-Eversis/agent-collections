{
  "name": "agent-collections",
  "version": "0.0.1",
  "private": true,
  "description": "Agent Collections — vendor-neutral multi-agent framework core",
  "scripts": {
    "sync:adapters": "node adapters/sync.mjs",
    "sync:adapters:check": "node adapters/sync.mjs --check",
    "sync:website-docs": "node adapters/website/generate.mjs",
    "sync:website-docs:check": "node adapters/website/generate.mjs --check",
    "mcp:build": "npm --prefix mcp/eversis-collections-mcp run build",
    "mcp:test": "npm --prefix mcp/eversis-collections-mcp test",
    "mcp:install": "npm --prefix mcp/eversis-collections-mcp install",
    "installer:smoke": "bash scripts/setup-agent-collections.test.sh",
    "website:install": "npm --prefix website install",
    "website:build": "npm --prefix website run build",
    "website:changelog:sync": "node scripts/sync-changelog.mjs",
    "website:changelog:check": "node scripts/sync-changelog.mjs --check"
  }
}
