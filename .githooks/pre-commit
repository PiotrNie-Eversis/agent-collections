#!/usr/bin/env bash
# .githooks/pre-commit — keep work-only paths off the production branch and out
# of framework core commits.
#
# Work-only paths are listed in .release-exclude (docs/specs, docs/context/<project>,
# docs/reports, docs/plans and docs/decisions entries; READMEs excluded there stay
# core). They live on develop and reach master only through
# scripts/release-to-master.sh, which strips them. Two checks:
#
#   1. On master/main: reject a commit that stages any work-only path.
#      ALLOW_MIXED_COMMIT does not lift this block.
#   2. On every other branch (including detached HEAD): reject a commit that
#      stages both work-only paths and core paths (deletions count). Commit the
#      core first, then the work-only paths (docs(ac-n), then docs(context)).
#      Deliberate exception: ALLOW_MIXED_COMMIT=1 git commit ...
#
# `git commit --no-verify` bypasses all hooks.
#
# Enable once per clone:  git config core.hooksPath .githooks

set -euo pipefail

branch="$(git symbolic-ref --quiet --short HEAD || true)"

root="$(git rev-parse --show-toplevel)"
helper="${root}/scripts/lib/release-paths.sh"
if [[ ! -f "$helper" ]]; then
  echo "pre-commit: ${helper} not found — cannot check work-only paths." >&2
  exit 1
fi
# shellcheck source=../scripts/lib/release-paths.sh
source "$helper"

case "$branch" in
  master|main)
    blocked="$(list_release_excluded_staged)"
    if [[ -n "$blocked" ]]; then
      echo "pre-commit: work-only paths cannot be committed on '${branch}' (production):" >&2
      echo "$blocked" | sed 's/^/  /' >&2
      echo "Commit them on develop (or a feature branch). master receives changes only via" >&2
      echo "scripts/release-to-master.sh, which leaves these paths out." >&2
      exit 1
    fi
    exit 0
    ;;
esac

# Other branches: reject a commit that mixes work-only and core paths.
[[ "${ALLOW_MIXED_COMMIT:-}" == "1" ]] && exit 0

load_release_exclude_specs

staged_names() {
  git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRD "$@" | LC_ALL=C sort -u
}

all_staged="$(staged_names)"
[[ -z "$all_staged" ]] && exit 0
work_staged="$(staged_names -- "${RELEASE_EXCLUDE_SPECS[@]}")"
[[ -z "$work_staged" ]] && exit 0
core_staged="$(LC_ALL=C comm -23 <(printf '%s\n' "$all_staged") <(printf '%s\n' "$work_staged"))"
[[ -z "$core_staged" ]] && exit 0

{
  echo "pre-commit: this commit mixes framework core and work-only paths (.release-exclude)."
  echo "Core paths:"
  printf '%s\n' "$core_staged" | sed 's/^/  /'
  echo "Work-only paths:"
  printf '%s\n' "$work_staged" | sed 's/^/  /'
  echo "Split it — core first, then the work-only paths:"
  echo "  git restore --staged <work-only paths>"
  echo "  git commit                                  # core first"
  echo "  git add <work-only paths> && git commit     # then docs(ac-n), then docs(context)"
  echo "Deliberate exception: ALLOW_MIXED_COMMIT=1 git commit ...   (--no-verify skips all hooks)"
} >&2
exit 1
