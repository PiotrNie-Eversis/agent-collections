{
  "enabledMcpjsonServers": ["eversis-collections"],
  "permissions": {
    "deny": [
      "Read(./**/.cursor/**)",
      "Read(./**/node_modules/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.secret)"
    ],
    "allow": ["Bash(git status)", "Bash(git diff *)", "Bash(git log *)"]
  }
}
